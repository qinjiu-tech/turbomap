{
  "name": "@turbomap/ol",
  "version": "0.1.0",
  "description": "OpenLayers 适配：地图与十万级 WebGL 打点。",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@turbomap/core": "workspace:*",
    "@turbomap/scheduler": "workspace:*"
  },
  "peerDependencies": {
    "ol": ">=9.5.0"
  },
  "devDependencies": {
    "@turbomap/core": "workspace:*",
    "@turbomap/scheduler": "workspace:*",
    "@types/node": "^24.10.1",
    "ol": "^10.11.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0"
  },
  "keywords": [
    "turbomap",
    "openlayers",
    "gis"
  ]
}
